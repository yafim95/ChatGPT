{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectMind Engineering AI",
  "version": "0.3.0",
  "identifier": "com.projectmind.engineeringai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ProjectMind Engineering AI",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 680,
        "dataDirectory": "webview-v0.3.0",
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ProjectMind",
    "copyright": "Copyright © 2026. All rights reserved.",
    "category": "Business",
    "shortDescription": "Local engineering project intelligence and controlled project memory.",
    "longDescription": "A Windows engineering knowledge and document-intelligence platform for construction project teams.",
    "externalBin": ["binaries/projectmind-backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
